{"_e":"metro:client_log","_t":1794341861495,"level":"log","data":["{\"meal\":{\"instructions\":[{\"display_text\":\"In a mixing bowl, beat eggs. Gradually add sugar. While beating slowly pour in oil. Add vanilla.\"},{\"display_text\":\"Combine the dry ingredients.\"},{\"display_text\":\"Add dry ingredients alternately with sour cream to the egg mixture.\"},{\"display_text\":\"Gently add blueberries.\"},{\"display_text\":\"Spoon into the greased muffin tin or paper liners\"},{\"display_text\":\"Bake at 400°F (200°C) for 20 minutes.\"},{\"display_text\":\"Enjoy!\"}],\"price\":{\"total\":2400},\"prep_time_minutes\":15,\"sections\":[{\"components\":[{\"raw_text\":\"4 eggs\",\"ingredient\":{\"name\":\"egg\",\"id\":19},\"measurements\":[{\"quantity\":\"4\"}]},{\"raw_text\":\"2 cups granulated sugar\",\"ingredient\":{\"name\":\"granulated sugar\"},\"measurements\":[{\"quantity\":\"2\"}]},{\"raw_text\":\"1 cup vegetable oil\",\"ingredient\":{\"name\":\"vegetable oil\"},\"measurements\":[{\"quantity\":\"1\"}]},{\"raw_text\":\"1 teaspoon vanilla extract\",\"ingredient\":{\"name\":\"vanilla extract\"},\"measurements\":[{\"quantity\":\"1\"}]},{\"raw_text\":\"4 cups flour\",\"ingredient\":{\"name\":\"flour\"},\"measurements\":[{\"quantity\":\"4\"}]},{\"raw_text\":\"1 teaspoon baking soda\",\"ingredient\":{\"name\":\"baking soda\"},\"measurements\":[{\"quantity\":\"1\"}]},{\"raw_text\":\"2 teaspoons baking powder\",\"ingredient\":{\"name\":\"baking powder\"},\"measurements\":[{\"quantity\":\"2\"}]},{\"raw_text\":\"2 cups (16oz) sour cream\",\"ingredient\":{\"name\":\"sour cream\"},\"measurements\":[{\"quantity\":\"2\"}]},{\"raw_text\":\"2 cups blueberries\",\"ingredient\":{\"name\":\"blueberry\"},\"measurements\":[{\"quantity\":\"2\"}]}]}],\"name\":\"Blueberry Cream Muffins\",\"num_servings\":24,\"aspect_ratio\":\"16:9\",\"thumbnail_url\":\"https://img.buzzfeed.com/tasty-app-user-assets-prod-us-east-1/recipes/4e9524578f544c888af761e10630593b.jpeg\",\"thumbnail_alt_text\":\"\",\"t